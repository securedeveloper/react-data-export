{
  "name": "react-data-export",
  "version": "1.0.0-alpha.3",
  "description": "Export data from React to .xlsx and .csv. 1.0 is a from-scratch rewrite in progress.",
  "license": "MIT",
  "author": "Afzal Ahmad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/securedeveloper/react-data-export.git",
    "directory": "packages/react-data-export"
  },
  "bugs": {
    "url": "https://github.com/securedeveloper/react-data-export/issues"
  },
  "homepage": "https://github.com/securedeveloper/react-data-export#readme",
  "keywords": [
    "react",
    "excel",
    "xlsx",
    "csv",
    "export",
    "spreadsheet"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./legacy": {
      "import": {
        "types": "./dist/legacy.d.ts",
        "default": "./dist/legacy.js"
      },
      "require": {
        "types": "./dist/legacy.d.cts",
        "default": "./dist/legacy.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=17 <20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance:doc": "UPDATE_CONFORMANCE_DOC=1 vitest run test/conformance/conformance.test.ts -t \"docs/conformance.md\"",
    "lint:pkg": "publint --strict && attw --pack . --profile node16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "javascript-excel": "^2.0.0-alpha.7"
  }
}
