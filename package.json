{
  "name": "react-data-export-workspace",
  "private": true,
  "description": "Workspace for react-data-export 1.0 (library + playground).",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w react-data-export && npm run build -w playground",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w react-data-export",
    "lint:pkg": "npm run lint:pkg -w react-data-export",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
