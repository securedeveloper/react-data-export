{
  "name": "react-data-export-workspace",
  "private": true,
  "description": "Workspace for react-data-export 1.0 (library + playground).",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build -w react-data-export && npm run build -w playground",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w react-data-export",
    "lint:pkg": "npm run lint:pkg -w react-data-export",
    "smoke": "node scripts/smoke.mjs",
    "consumer-ts": "node scripts/consumer-ts.mjs",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "test:release": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
